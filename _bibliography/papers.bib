@techreport{belluemahler2026,
  title={Early Decisions, Long-Lasting Consequences: The Macroeconomics of School Tracking},
  author={Lukas Mahler and Suzanne Bellue},
  abstract={School tracking---sorting students into different school programs---is widespread and shapes how students accumulate skills. We study its aggregate, distributional, and intergenerational effects in a general-equilibrium overlapping-generations model with endogenous school-track choices and a novel skill formation technology trading off learning gains from homogeneous groups against the risk of misallocating children whose skills are still developing. Calibrated to Germany's early-tracking system, the model shows that delaying tracking from age 10 to 14 improves intergenerational mobility and reduces inequality but generates modest efficiency losses. These losses arise only in general equilibrium, as a falling college wage premium dampens college expansion.},
  year={2026},  
  pdf={BM-TrackingOct2026.pdf},
  topic = {wp}
}

@article{mahleryum2024,
  title={Lifestyle Behaviors and Wealth-Health Gaps in Germany},
  author={Lukas Mahler and Minchul Yum},
  abstract={We document significant gaps in wealth across health status over the life cycle in Germany---a country with a universal healthcare system and negligible out-of-pocket medical expenses. To investigate the underlying sources of these wealth-health gaps, we build a heterogeneous-agent life-cycle model in which health and wealth evolve endogenously. In the model, agents exert efforts to lead a healthy lifestyle, which helps maintain good health status in the future. Effort choices, or lifestyle behaviors, are subject to adjustment costs to capture their habitual nature in the data. We find that our estimated model generates the great majority of the empirical wealth gaps by health and quantify the role of earnings and savings channels through which health affects these gaps. We show that variations in individual health efforts account for around a quarter of the model-generated wealth gaps by health, illustrating their role as an amplification mechanism behind the gaps.},
  year={2024},
  pdf={MahlerYum-Aug2024.pdf},
journal={Econometrica},
abbr={ECTA},
volume = {92},
number = {5},
%month = {September},
pages = {1697-1733},
%doi = {10.3982/ECTA20603},
html = {https://doi.org/10.3982/ECTA20603},
  topic = {pup}
}


